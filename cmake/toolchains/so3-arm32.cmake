set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED ENV{POCKET_SO3_CC_ARM32} OR "$ENV{POCKET_SO3_CC_ARM32}" STREQUAL "")
  message(FATAL_ERROR "Set POCKET_SO3_CC_ARM32 to the SO3 arm-linux-musleabihf-gcc driver")
endif()

set(CMAKE_C_COMPILER "$ENV{POCKET_SO3_CC_ARM32}" CACHE FILEPATH "SO3 ARM32 C compiler")
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mthumb -mfpu=neon -mfloat-abi=hard")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
